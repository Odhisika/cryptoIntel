# =============================================================================
# Crypto Intel — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# Django
DJANGO_SECRET_KEY=change-me-to-a-real-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Postgres in Docker)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=crypto_intel
DB_USER=crypto_intel
DB_PASSWORD=crypto_intel_dev
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# API Keys (all optional — public endpoints work without them)
COINGECKO_API_KEY=
GITHUB_TOKEN=
BINANCE_API_KEY=

# Docker port overrides (optional)
WEB_PORT=8000
DB_PORT_EXTERNAL=5432
REDIS_PORT_EXTERNAL=6379
