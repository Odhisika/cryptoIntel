# =============================================================================
# Crypto Intel — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# Django
DJANGO_SECRET_KEY=change-me-to-a-real-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Postgres in Docker)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=crypto_intel
DB_USER=crypto_intel
DB_PASSWORD=crypto_intel_dev
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# JWT — must match the main site's signing key and algorithm
JWT_SIGNING_KEY=change-me-to-main-site-secret
JWT_ALGORITHM=HS256
JWT_USER_ID_FIELD=user_id

# Paystack (webhook secret from Paystack dashboard)
PAYSTACK_SECRET_KEY=

# API Keys (all optional — public endpoints work without them)
COINGECKO_API_KEY=
GITHUB_TOKEN=
BINANCE_API_KEY=

# Docker port overrides (optional)
WEB_PORT=8000
DB_PORT_EXTERNAL=5433
REDIS_PORT_EXTERNAL=6380
